# Copiar este archivo como .env y rellenar los valores. El .env no se sube al repositorio.

# Base de datos (los usa docker-compose.yml y Spring Boot)
DB_HOST=localhost
DB_PORT=3308
DB_NAME=hotel_host
DB_USER=hotel_host
DB_PASSWORD=cambiar_esta_password
DB_ROOT_PASSWORD=cambiar_esta_password_root

# Servidor
SERVER_PORT=8081

# CORS: origenes del frontend permitidos, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT: clave de firma (minimo 32 caracteres, aleatoria) y duracion del token en horas
JWT_SECRET=cambiar_por_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRATION_HOURS=12

# Admin inicial (se crea al arrancar si no existe ningun admin; debera cambiar la contrasena al entrar)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_esta_password
